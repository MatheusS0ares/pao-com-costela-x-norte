# Pode ser um projeto Supabase dedicado deste cliente, OU um projeto
# compartilhado com outros apps do monorepo (o free tier só permite 2
# projetos por conta). Se for compartilhado, o isolamento vem do schema
# Postgres (ver NEXT_PUBLIC_SUPABASE_SCHEMA abaixo), não do projeto.
# Criar/abrir em https://app.supabase.com, rodar supabase/schema.sql
# no SQL Editor e copiar as chaves em Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Settings → API → service_role. NUNCA prefixar com NEXT_PUBLIC_, nunca
# expor ao browser — só é lido em código server-only (src/lib/supabase/admin.ts),
# usado exclusivamente para gravar o pedido do site público sem sessão.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Schema Postgres onde vivem as tabelas deste app — "xnorte" enquanto o
# Supabase for compartilhado com outros projetos do monorepo, "public" se
# um dia este cliente ganhar um projeto Supabase só dele (nesse caso,
# rodar de novo o schema.sql trocando "xnorte." por nada / "public").
# Depois de rodar schema.sql, ir em Settings → API → Data API →
# "Exposed schemas" e adicionar "xnorte" na lista — sem isso a API não
# enxerga essas tabelas.
NEXT_PUBLIC_SUPABASE_SCHEMA=xnorte

# Nome do bucket de Storage das fotos do cardápio — precisa bater com o
# que foi criado em supabase/schema.sql (prefixado pra não colidir com
# bucket de outro app no mesmo projeto).
NEXT_PUBLIC_SUPABASE_BUCKET=xnorte-cardapio

# Mesmo valor configurado no header "x-revalidate-secret" do Database
# Webhook do Supabase (Database → Webhooks → tabelas do catálogo → POST
# para /api/revalidate). Gerar uma string aleatória qualquer.
REVALIDATE_SECRET=

# URL pública de produção — usada em metadata, sitemap e robots.txt.
NEXT_PUBLIC_SITE_URL=https://xnorte.vercel.app
